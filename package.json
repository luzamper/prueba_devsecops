{
  "name": "prueba_devsecops",
  "version": "1.0.0",
  "description": "Proyecto base de capacitacion DevSecOps: JavaScript, HTML y CSS sin dependencias externas",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-server.js",
    "dev": "node --watch scripts/dev-server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verificar": "node scripts/verificar.js",
    "audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "devsecops",
    "capacitacion",
    "javascript",
    "html",
    "css"
  ],
